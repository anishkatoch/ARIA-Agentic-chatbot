# ── LLM ───────────────────────────────────────────────────────
# Groq (free - 14,400 req/day): https://console.groq.com → API Keys
GROQ_API_KEY=

# OpenAI (paid fallback): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Embeddings ─────────────────────────────────────────────────
# HuggingFace Inference API: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Voyage AI (https://dash.voyageai.com/api-keys) - set embeddings.provider: voyage in config.yaml to use
VOYAGE_API_KEY=

# ── Reranking ────────────────────────────────────────────────────
# Cohere (https://dashboard.cohere.com/api-keys) - trial key works for dev
COHERE_API_KEY=

# ── Database (Supabase or any PostgreSQL) ──────────────────────
# Project Settings → Database
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Neo4j (Phase 7 - Advanced Mode graph retrieval) ───────────
# Free AuraDB instance: https://neo4j.com/cloud/aura-free/
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── App env ────────────────────────────────────────────────────
APP_ENV=development

# ── WhatsApp (Twilio) ──────────────────────────────────────────
# Set to "true" to mount the /whatsapp/webhook router.
WHATSAPP_ENABLED=false
# Twilio console: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# All other settings (models, limits, retrieval params) live in config.yaml

# ── Source Connectors (CONNECTOR_POC integration) ───────────────
# Access gate - required before ANY /connectors/* endpoint works, on top of
# normal login. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CONNECTORS_ACCESS_KEY=

# Google OAuth - shared by Gmail + Google Drive connectors
# Credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console.
# Use localhost for local dev; swap to your HF Space URL once deployed.
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/google-drive/callback

# Microsoft Entra ID / Microsoft Graph - SharePoint + Teams
# Register an app: https://entra.microsoft.com → App registrations
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Azure DevOps Repos
# PAT: https://dev.azure.com/<org>/_usersSettings/tokens
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organization
AZURE_DEVOPS_PAT=

# GitHub - personal access token (repo read scope): https://github.com/settings/tokens
# Replaces CONNECTOR_POC's original `gh auth token` approach, which only works
# on a machine where the `gh` CLI is already logged in and breaks on deploy.
GITHUB_TOKEN=

# Jira Cloud - API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# ServiceNow Table API
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Salesforce REST API - connected app: Setup → App Manager → New Connected App
SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:8000/salesforce/callback

# File Share connector - local/dev only; points at a directory on disk, no
# equivalent once deployed to HF Spaces (no persistent local filesystem).
FILE_SHARE_ROOT=
