# ── LLM ───────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# OpenAI (paid fallback - leave blank if not using)
OPENAI_API_KEY=sk-proj-...

# ── Embeddings ─────────────────────────────────────────────────
HUGGINGFACE_API_KEY=hf_...

# Voyage AI (https://dash.voyageai.com/api-keys) - set embeddings.provider: voyage in config.yaml to use
VOYAGE_API_KEY=

# ── Reranking ────────────────────────────────────────────────────
# Cohere (https://dashboard.cohere.com/api-keys) - trial key works for dev
COHERE_API_KEY=

# ── Database (Supabase Postgres) ───────────────────────────────
DB_HOST=db.<your-project>.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=postgres

# ── Supabase Auth ──────────────────────────────────────────────
# Project URL and keys from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Auth / JWT ─────────────────────────────────────────────────
# Used to sign guest tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-use-a-long-random-string

# ── Neo4j (Advanced Mode - Graph DB) ──────────────────────────
# Free AuraDB: https://neo4j.com/cloud/aura-free/
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── App ────────────────────────────────────────────────────────
APP_ENV=development

# ── WhatsApp (Twilio) ──────────────────────────────────────────
# Set to "true" to mount the /whatsapp/webhook router.
WHATSAPP_ENABLED=false
# Twilio console: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Source Connectors (CONNECTOR_POC integration) ──────────────
# Access gate - required before ANY /connectors/* endpoint works, on top of
# normal login. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CONNECTORS_ACCESS_KEY=your-connectors-access-key

# Google OAuth - shared by Gmail + Google Drive + Google Chat connectors
# (Google Chat shares Gmail's grant - no separate client id/secret/redirect)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match the redirect URI registered in Google Cloud Console.
# Use localhost for local dev; swap to your HF Space URL once deployed.
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/google-drive/callback

# Microsoft Entra ID / Microsoft Graph - SharePoint + Teams (app-only,
# client-credentials - needs a specific tenant) AND Outlook + Outlook Chat
# (delegated user OAuth - shares this same app registration's client id/
# secret, but signs in via the "common" authority unless MICROSOFT_TENANT_ID
# is set, so it works without a tenant-specific restriction too).
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-application-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
# Must match a "Web" platform redirect URI registered on that same app
# registration in Azure Portal, with Mail.Read + Chat.Read + offline_access
# delegated permissions granted (admin consent may be required).
OUTLOOK_REDIRECT_URI=http://localhost:8000/outlook/callback

# Azure DevOps Repos
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organization
AZURE_DEVOPS_PAT=your-personal-access-token

# GitHub - personal access token (repo read scope). Replaces CONNECTOR_POC's
# original approach of shelling out to `gh auth token`, which only works on a
# machine where the `gh` CLI is already logged in and won't work when deployed.
GITHUB_TOKEN=your-github-personal-access-token

# ── Admin portal (single fixed super-admin account) ────────────
# Only way to log into /admin.html - no signup/signin for this account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
